# IdM SRE Lab 环境配置

# LLM（沿用 Interview/.env）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.MiniMax.chat/v1
LLM_MODEL=MiniMax-M3
LLM_TEMPERATURE=0.3

# JWT 密钥（生产环境用 KMS 生成）
JWT_SECRET=dev-secret-change-me-in-production-32bytes-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=2592000

# OAuth2 / OIDC
OAUTH_ISSUER=http://localhost:8000
OAUTH_CLIENT_ID=idm-sre-lab-client
OAUTH_CLIENT_SECRET=dev-client-secret-change-me

# SAML 2.0
SAML_SP_ENTITY_ID=http://localhost:8000/saml/metadata
SAML_SP_ACS_URL=http://localhost:8000/saml/acs
SAML_IDP_ENTITY_ID=http://localhost:8000/saml/idp-metadata

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=IdM SRE Lab
WEBAUTHN_ORIGIN=http://localhost:8000

# 数据库
DATABASE_URL=sqlite:///./data/idm.db

# Web UI
WEB_HOST=0.0.0.0
WEB_PORT=8000

# SLO 配置
SLO_AVAILABILITY_TARGET=0.999
SLO_P99_LATENCY_TOKEN_MS=200
SLO_P99_LATENCY_SAML_MS=500